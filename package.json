{
  "name": "openlude",
  "productName": "Openlude",
  "version": "0.6.2",
  "private": true,
  "description": "A desktop launcher with procedural launch animations",
  "author": "Openlude",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "build": "npm run typecheck && node scripts/build-native.mjs && tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "node --test \"dist-electron/main/*.test.js\" scripts/pack-release.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "dev:site": "npm run build:site && vite preview --config site/vite.config.mts --host 127.0.0.1 --port 4174",
    "build:site": "tsc -p site/tsconfig.json && node scripts/build-site.mjs",
    "test:site": "node scripts/site-smoke.mjs",
    "assets:site": "node scripts/site-assets.mjs",
    "test:preview": "node scripts/preview-smoke.mjs",
    "pack:mac": "npm run build && electron-builder --mac dir --config.mac.identity=- --publish never",
    "pack:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:preview": "node scripts/pack-preview.mjs",
    "pack:release": "npm run build && node scripts/pack-release.mjs",
    "test:external": "node scripts/external-launch-smoke.mjs",
    "test:windows-observer": "node scripts/windows-observer-smoke.mjs",
    "test:regressions": "node scripts/regression-smoke.mjs",
    "assets:thumbnails": "node scripts/build-thumbnails.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "studio.openlude.desktop",
    "productName": "Openlude",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "native/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/assets/branding/app-icon.icns",
      "binaries": [
        "Contents/Resources/native/launch-observer-darwin-arm64",
        "Contents/Resources/native/launch-observer-darwin-x64"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/assets/branding/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "*.ps1"
        ]
      },
      {
        "from": "dist-native",
        "to": "native",
        "filter": [
          "launch-observer-darwin-*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Liuhuazhong0801",
        "repo": "Openlude"
      }
    ]
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liuhuazhong0801/Openlude.git"
  },
  "homepage": "https://github.com/Liuhuazhong0801/Openlude#readme",
  "bugs": {
    "url": "https://github.com/Liuhuazhong0801/Openlude/issues"
  },
  "license": "MIT",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
